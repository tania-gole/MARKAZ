{
  "name": "@markaz/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "start": "dotenv -e ../../.env -- next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .next dist .turbo"
  },
  "dependencies": {
    "@markaz/core": "workspace:*",
    "@markaz/types": "workspace:*",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
